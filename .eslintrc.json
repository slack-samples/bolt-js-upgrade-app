{
    "env": {
        "browser": false,
        "es2021": true
    },
    "extends": [
        "airbnb-base"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "object-curly-newline": "off",
        "camelcase": "off",
        "import/extensions": "off",
        "import/prefer-default-export": "off",
        "no-console": "off"
    }
}
